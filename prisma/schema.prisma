// Phase 2: core identity, RBAC, sessions, audit. Shopify stays the source of truth for
// products/orders/payments (Phase 4); HX DB stores supporting data only.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  name         String?
  phone        String?
  passwordHash String
  role         Role             @default(CUSTOMER)
  locale       String           @default("ar")
  disabledAt   DateTime?
  createdAt    DateTime         @default(now())
  sessions     Session[]
  addresses    Address[]
  auditLogs    AuditLog[]
  permissions  UserPermission[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique // SHA-256 of the cookie token; raw token never stored
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String
  emirate   String
  area      String
  street    String
  building  String
  apartment String?
  kind      String  @default("home")
  mapUrl    String?
  notes     String?

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model WebhookEvent {
  id         String   @id // X-Shopify-Webhook-Id
  topic      String
  receivedAt DateTime @default(now())
}

// ───────────────────────────── HX Core (shared by NAJM AI, Social, Marketing, Reels) ─────────────────────────────

/// Extra permissions granted on top of the role defaults (src/lib/core/permissions.ts).
model UserPermission {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission String
  grantedBy  String?
  createdAt  DateTime @default(now())

  @@id([userId, permission])
}

/// AES-256-GCM ciphertext only. The plaintext never reaches this table, the browser, logs or Git.
model Secret {
  name        String   @id
  ciphertext  String
  iv          String
  tag         String
  keyId       String
  fingerprint String // last 4 characters, for humans to recognise a value
  updatedBy   String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

enum IntegrationMode {
  disabled
  dry_run // everything is evaluated and logged, nothing is sent to the outside world
  test // real calls, restricted to test accounts / read-only scopes
  live // real calls for real customers (needs explicit owner approval)
}

model Integration {
  key            String          @id // shopify, meta_messaging, meta_ads, najm_llm, hx_studio, storage
  mode           IntegrationMode @default(dry_run)
  enabled        Boolean         @default(false)
  status         String          @default("unknown") // unknown | not_configured | ok | degraded | error
  statusDetail   String?
  lastCheckAt    DateTime?
  lastOkAt       DateTime?
  liveApprovedBy String?
  liveApprovedAt DateTime?
  updatedAt      DateTime        @updatedAt
}

enum JobStatus {
  queued
  running
  succeeded
  failed // will be retried at runAt
  dead // gave up after maxAttempts: needs a human
  cancelled
}

model Job {
  id             String    @id @default(cuid())
  type           String
  payload        Json
  status         JobStatus @default(queued)
  priority       Int       @default(0)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  runAt          DateTime  @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  lastError      String?
  result         Json?
  idempotencyKey String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  finishedAt     DateTime?

  @@index([status, runAt])
  @@index([type, status])
}

model WebhookDelivery {
  id             String   @id @default(cuid())
  source         String // shopify | meta
  eventId        String // provider delivery id, or SHA-256 of the raw body when none exists
  topic          String?
  signatureValid Boolean
  status         String   @default("received") // received | queued | duplicate | rejected | processed | failed
  error          String?
  payload        Json? // only stored when the signature is valid
  jobId          String?
  receivedAt     DateTime @default(now())

  @@unique([source, eventId])
  @@index([source, receivedAt])
}

model Notification {
  id             String    @id @default(cuid())
  level          String // info | warning | error
  source         String // core | jobs | shopify | meta_messaging | ...
  title          String
  body           String?
  actionRequired Boolean   @default(false)
  dedupeKey      String?   @unique // same problem → one open notification
  count          Int       @default(1)
  readAt         DateTime?
  resolvedAt     DateTime?
  resolvedBy     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([resolvedAt, createdAt])
}

model SyncLog {
  id          String    @id @default(cuid())
  integration String
  operation   String
  status      String // running | ok | error
  items       Int       @default(0)
  error       String?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([integration, startedAt])
}

/// One person across channels (website account, Instagram, Facebook, WhatsApp ...).
model Contact {
  id          String            @id @default(cuid())
  displayName String?
  userId      String?           @unique
  firstSeenAt DateTime          @default(now())
  lastSeenAt  DateTime          @default(now())
  identities  ContactIdentity[]
  grants      DownloadGrant[]
}

model ContactIdentity {
  id         String   @id @default(cuid())
  channel    String // web | instagram | facebook | ...
  externalId String // platform-scoped id (e.g. Instagram-scoped user id), never a password
  contactId  String
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([channel, externalId])
}

enum FileVisibility {
  private // needs a download grant
  free // may be granted to anyone a campaign targets (still via an expiring grant)
}

model StoredFile {
  id         String          @id @default(cuid())
  storageKey String          @unique
  name       String
  kind       String // stl | 3mf | pdf | mp4 | png | jpg | other
  mime       String
  size       Int
  sha256     String
  visibility FileVisibility  @default(private)
  productRef String? // Shopify product GID, when linked
  uploadedBy String?
  deletedAt  DateTime?
  createdAt  DateTime        @default(now())
  grants     DownloadGrant[]

  @@index([sha256])
}

/// Expiring, revocable, use-limited download link. Only the SHA-256 of the token is stored.
model DownloadGrant {
  id           String     @id @default(cuid())
  tokenHash    String     @unique
  fileId       String
  file         StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  contactId    String?
  contact      Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  reason       String // campaign:<id> | order:<id> | manual
  expiresAt    DateTime
  maxDownloads Int        @default(3)
  downloads    Int        @default(0)
  revokedAt    DateTime?
  revokedBy    String?
  createdBy    String?
  createdAt    DateTime   @default(now())
  lastUsedAt   DateTime?

  @@index([fileId])
  @@index([contactId])
}

/// Unified activity stream: every system writes here, the Command Center reads from here.
model ActivityEvent {
  id         String   @id @default(cuid())
  system     String // core | najm | social | marketing | reels | shop
  type       String // contact.message | file.sent | video.published | order.created ...
  contactId  String?
  videoId    String? // Reels Studio video that led to this event (attribution)
  campaignId String?
  amount     Decimal? @db.Decimal(12, 2)
  currency   String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([system, type, createdAt])
  @@index([videoId])
  @@index([contactId])
}
