// Phase 2: core identity, RBAC, sessions, audit. Shopify stays the source of truth for
// products/orders/payments (Phase 4); HX DB stores supporting data only.
generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  phone        String?
  passwordHash String
  role         Role      @default(CUSTOMER)
  locale       String    @default("ar")
  disabledAt   DateTime?
  createdAt    DateTime  @default(now())
  sessions     Session[]
  addresses    Address[]
  auditLogs    AuditLog[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique   // SHA-256 of the cookie token; raw token never stored
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String
  emirate   String
  area      String
  street    String
  building  String
  apartment String?
  kind      String  @default("home")
  mapUrl    String?
  notes     String?
  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())
  @@index([entity, entityId])
  @@index([createdAt])
}

model WebhookEvent {          // idempotency for Shopify webhooks (Phase 4)
  id         String   @id      // X-Shopify-Webhook-Id
  topic      String
  receivedAt DateTime @default(now())
}

// ---- Private file delivery ----
// Files live outside the public web root. Only a hashed download token is stored, never the token itself.
model DeliverableFile {
  id          String         @id @default(cuid())
  title       String
  keyword     String         @unique   // normalised (lowercase, Arabic letters folded)
  description String?
  storageName String         @unique   // random name on disk, never the original name
  originalName String
  mime        String
  size        Int
  sha256      String
  createdAt   DateTime       @default(now())
  active      Boolean        @default(true)
  links       DownloadLink[]
}

model DownloadLink {
  id           String          @id @default(cuid())
  tokenHash    String          @unique
  fileId       String
  file         DeliverableFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  recipient    String?         // internal label only, e.g. "Instagram order #12"
  expiresAt    DateTime
  maxDownloads Int             @default(1)
  downloads    Int             @default(0)
  revokedAt    DateTime?
  createdAt    DateTime        @default(now())
  events       DownloadEvent[]
  draft        ReplyDraft?
  @@index([fileId])
}

model DownloadEvent {
  id        String       @id @default(cuid())
  linkId    String
  link      DownloadLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  @@index([linkId])
}

// ---- Instagram inbound messages/comments -> reply drafts awaiting admin approval ----
// Nothing is sent by this code. A draft becomes a download link only when an admin approves it.
model ReplyDraft {
  id           String    @id @default(cuid())
  channel      String    // "instagram_dm" | "instagram_comment"
  senderRef    String    // Meta-scoped user id (needed to reply), never a phone or email
  inboundText  String    // trimmed to 300 characters
  inboundMid   String    @unique // Meta message/comment id: idempotency
  keyword      String
  fileId       String?
  draftText    String
  status       String    @default("pending") // pending | approved | rejected
  linkId       String?   @unique // set on approval
  link         DownloadLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  decidedAt    DateTime?
  decidedBy    String?
  @@index([status, createdAt])
}
