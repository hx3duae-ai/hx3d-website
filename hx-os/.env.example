# Copy to .env.local and fill in what you use. Everything is optional:
# without keys the app still runs fully offline with the built-in idea engine.

# Claude API: richer daily ideas, carousels and reel scripts (Content OS).
ANTHROPIC_API_KEY=

# Cal.com: pull bookings into the CRM (Settings > Developer > API keys).
CAL_API_KEY=
# Cal.com webhook secret (Settings > Developer > Webhooks). Used to verify
# POST /api/webhooks/calcom when you expose the app with a tunnel.
CAL_WEBHOOK_SECRET=

# Instagram (optional). Without these, OOTTO agents do the sending and HX OS
# keeps the queue + CRM. With them, HX OS sends catalog DMs itself via the
# official Instagram Graph API (instagram_manage_comments + instagram_manage_messages).
META_PAGE_TOKEN=
IG_USER_ID=
# Meta webhook (GET/POST /api/webhooks/meta): verify token you choose + app secret for signatures.
META_VERIFY_TOKEN=
META_APP_SECRET=

# Where JSON data and rendered media live (default: ./data)
HX_DATA_DIR=

# Rendering (optional): use an existing Chrome instead of Remotion's own download,
# and a specific ffmpeg binary. Put background music at assets/music.mp3.
HX_BROWSER_EXECUTABLE=
FFMPEG_PATH=
