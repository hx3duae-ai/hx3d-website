# Copy to .env (never commit). Secrets stay server-side only.
DATABASE_URL="postgresql://hx:hx@localhost:5432/hxhub"
SESSION_SECRET="change-me-32+chars-random"
# Shopify (read-only phase). Put secrets only in your local .env, never in chat or Git.
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
SHOPIFY_API_VERSION="2025-10"
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""
SHOPIFY_WEBHOOK_SECRET=""
ENCRYPTION_KEY=""
SITE_URL="https://hx3d.ae"

# ── HX Core ──────────────────────────────────────────────────────────
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Without it, secrets cannot be saved. Losing it makes saved secrets unreadable (re-enter them).
ENCRYPTION_KEY=""
# Only during key rotation: the old key, then run rotateAll() and remove this line.
ENCRYPTION_KEY_PREVIOUS=""
# Private file storage (outside the web root). Use a persistent disk in production.
STORAGE_DIR="./uploads-private"
STORAGE_MAX_MB="200"
# HX Studio (Python media/3D engine), e.g. http://localhost:8420 — used for health checks now, Reels Studio later.
HX_STUDIO_URL=""
# Meta (can also be entered in Admin → System, stored encrypted). Not used until Social Automation (phase 4).
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN=""
